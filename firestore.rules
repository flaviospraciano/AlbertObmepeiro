rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // É Admin Maestro quem tem um documento em /admins/{seu UID}
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Cada aluno (Albertzão) é um documento em /jogadores/{UID}
    match /jogadores/{uid} {
      // o próprio aluno lê e grava só o seu progresso
      allow read, create, update: if request.auth != null && request.auth.uid == uid;
      // o professor lê todos e pode apagar
      allow read, delete: if isAdmin();
    }

    // Lista de professores: só o próprio usuário consegue ver se é admin.
    // Os documentos são criados à mão no Console do Firebase.
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
  }
}
